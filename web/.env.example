# ── AI-Native CMS environment ───────────────────────────────────────────────
# Copy to .env.local for local admin use. Set the same values in Vercel for the
# hosted client editor. Local admin and the hosted editor SHARE one database.

# MongoDB Atlas connection string.
# REQUIRED in production. Set it locally too, so sites you build/clone locally
# are written to the same Atlas DB the hosted editor reads from.
# (If unset locally, the app falls back to the filesystem at web/.data — handy
#  for offline dev, but those sites won't appear on the deployed editor.)
MONGODB_URI=

# Optional: database name (default: ai_native_cms)
# MONGODB_DB=ai_native_cms

# Secret used to sign client session cookies.
# REQUIRED in production (the app refuses to start without it). Use a long random
# string, e.g.  openssl rand -hex 32
CMS_SESSION_SECRET=

# Password for the LOCAL admin dashboard. Required to open it — with this unset
# the admin refuses to load rather than falling back to a default password.
# Leave this unset in production, where the admin is disabled anyway.
ADMIN_PASSWORD=

# Your public URL, used for canonical links, OpenGraph tags, robots.txt and
# sitemap.xml. Set it on the deployment; it defaults to castorcms.vercel.app.
# SITE_URL=https://your-project.vercel.app

# Images are referenced by URL (paste a link in the editor) — no upload storage
# to configure.

# Note: Castor contains no AI, so there are no provider/API keys to configure.
# Form submissions need no config either — they're stored in the same database.

# Optional: domains that `npm run deploy` re-points at each new deployment.
# Space or comma separated. Leave unset to just deploy without touching aliases.
# CASTOR_ALIASES="yourproject.vercel.app"

# Owner tooling: where `npm run dist` publishes the buyer-facing snapshot.
# CASTOR_DIST_PATH="~/castor-dist"
